      "type": "continuous",
      "meaning": "Refraction strength (bounded screen displacement)"
    },
    "detail": {
      "min": 0,
      "max": 1,
      "default": 0.6,
      "type": "continuous",
      "meaning": "Fine caustic ridges"
    },
    "hue": {
      "min": 0,
      "max": 1,
      "default": 0.35,
