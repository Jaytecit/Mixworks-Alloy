{
  "schema": 1,
  "key": "original/waterglass",
  "title": "Waterglass",
  "author": "Mixworks / Jay with AI assistance",
  "source": "Original purpose-built scene prototype, 2 November 2026. No reference source or assets bundled.",
  "family": "hand-authored",
  "variant": 3,
  "study": "waterly",
  "controls": {
    "intensity": {
      "min": 0,
      "max": 1,
      "default": 0.7,
      "type": "continuous"
    },
    "motion": {
      "min": 0,
      "max": 1,
