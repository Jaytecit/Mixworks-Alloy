      "meaning": "Optical field horizontal centre"
    },
    "focusY": {
      "min": 0,
      "max": 1,
      "default": 0.5,
      "type": "xy",
      "group": "focus",
      "meaning": "Optical field vertical centre"
    },
    "colourR": {
      "min": 0,
      "max": 1,
      "default": 0.7,
      "type": "colour",
      "group": "tint"
    },
    "colourG": {
      "min": 0,
      "max": 1,
      "default": 0.82,
      "type": "colour",
      "group": "tint"
    },
    "colourB": {
      "min": 0,
      "max": 1,
      "default": 0.78,
      "type": "colour",
      "group": "tint"
    },
    "pulse": {
      "min": 0,
      "max": 1,
      "default": 0.5,
      "type": "pulse",
      "meaning": "Bass caustic impulse"
    },
    "mode": {
      "min": 0,
      "max": 1,
      "default": 1.0,
      "type": "choice",
      "steps": 4
    },
    "mirror": {
      "min": 0,
      "max": 1,
      "default": 0.0,
      "type": "toggle",
      "steps": 2
    },
    "imageZoom": {
      "min": 0,
      "max": 1,
      "default": 0.35,
      "type": "continuous"
    },
    "imageRotation": {
      "min": 0,
      "max": 1,
      "default": 0.5,
      "type": "continuous"
    },
    "imageIndex": {
      "min": 0,
      "max": 1,
      "default": 0.0,
      "type": "counter"
    },
    "feedback": {
      "min": 0,
      "max": 1,
      "default": 0.65,
      "type": "continuous"
    }
  },
  "passSchema": 1,
  "passes": [
    {
      "shader": "main.glsl",
      "scale": 1,
      "format": "rgba16f",
      "id": "light"
    },
    {
      "inputs": [
        "light"
      ],
      "shader": "bloom-x.glsl",
      "scale": 0.25,
      "format": "rgba16f",
      "id": "bloomx"
    },
    {
      "inputs": [
        "bloomx"
      ],
      "shader": "bloom-y.glsl",
      "scale": 0.25,
      "format": "rgba16f",
      "id": "bloomy"
    },
    {
      "inputs": [
        "light",
        "bloomy"
      ],
      "shader": "finish.glsl",
      "scale": 1,
      "format": "rgba8",
      "id": "finish"
    }
  ],
  "mediaRole": "screen-refraction",
  "audioMapping": {
    "bass": "Alternating kick-driven cross-currents and wave fronts",
    "mid": "Reversing vortex shear and rigid artwork movement",
    "treble": "Fine ripple advection"
  },
  "motionProfile": "EDM 120\u2013160 BPM; band-weighted alternating beat/subdivision motion"
