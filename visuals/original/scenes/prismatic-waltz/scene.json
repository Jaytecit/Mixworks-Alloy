          "frame": "current"
        }
      ]
    },
    {
      "id": "finish",
      "shader": "fragments.glsl",
      "vertex": "fragments-vertex.glsl",
      "instances": 2880,
      "scale": 1,
      "format": "rgba8",
      "inputs": [
        {
          "pass": "particles",
          "frame": "current"
        },
        {
          "pass": "capture",
          "frame": "current"
        }
      ]
    },
    {
      "id": "scenery",
      "shader": "main.glsl",
      "scale": 1,
      "format": "rgba8",
      "inputs": [
        {
          "pass": "finish",
          "frame": "current"
        }
      ]
    }
  ],
