{
  "schema": 1,
  "key": "original/overdrive-rings",
  "title": "Overdrive Rings",
  "author": "Mixworks / Jay with AI assistance",
  "source": "Original Mixworks particle dynamics and image fragmentation; no reference implementation copied.",
  "family": "sprite-particles",
  "variant": 7,
  "study": "overload",
  "controls": {
    "intensity": {
      "min": 0,
      "max": 1,
      "default": 0.7,
      "type": "continuous"
    },
    "motion": {
      "min": 0,
      "max": 1,
      "default": 0.5,
      "type": "speed",
      "label": "Particle speed"
    },
    "imageMix": {
      "min": 0,
      "max": 1,
      "default": 0.85,
      "type": "continuous",
      "label": "Source refresh"
    },
    "scale": {
      "min": 0,
      "max": 1,
      "default": 0.48,
      "type": "continuous",
      "label": "Fragment size"
    },
    "warp": {
      "min": 0,
      "max": 1,
      "default": 0.65,
      "type": "continuous",
      "label": "Dispersion"
    },
    "detail": {
      "min": 0,
      "max": 1,
      "default": 0.55,
      "type": "continuous",
      "label": "Fragment edges"
    },
    "mode": {
      "min": 0,
      "max": 1,
      "default": 0.0,
      "type": "choice",
      "steps": 4,
      "label": "Behaviour A / B / C / D"
    },
    "pulse": {
      "min": 0,
      "max": 1,
      "default": 0.7,
      "type": "pulse",
      "label": "Attack force"
    },
    "feedback": {
      "min": 0,
      "max": 1,
      "default": 0.6,
      "type": "continuous",
      "label": "Momentum"
    },
    "imageZoom": {
      "min": 0,
      "max": 1,
      "default": 0.35,
      "type": "continuous",
      "label": "Source framing"
    },
    "imageRotation": {
      "min": 0,
      "max": 1,
      "default": 0.5,
      "type": "continuous",
      "label": "Source rotation"
    },
    "focusX": {
      "min": 0,
      "max": 1,
      "default": 0.5,
      "type": "xy",
      "group": "focus"
    },
    "focusY": {
      "min": 0,
      "max": 1,
      "default": 0.5,
      "type": "xy",
      "group": "focus"
    },
    "colourR": {
      "min": 0,
      "max": 1,
      "default": 0.7,
      "type": "colour",
      "group": "tint"
    },
    "colourG": {
      "min": 0,
      "max": 1,
      "default": 0.58,
      "type": "colour",
      "group": "tint"
    },
    "colourB": {
      "min": 0,
      "max": 1,
      "default": 0.78,
      "type": "colour",
      "group": "tint"
    }
  },
  "passSchema": 2,
  "passes": [
    {
      "id": "capture",
      "shader": "capture.glsl",
      "size": [
        512,
        288
      ],
      "format": "rgba16f",
      "state": true,
      "semantic": "premultiplied-source-atlas-v1",
      "history": true,
      "inputs": [
        {
          "pass": "capture",
          "frame": "previous"
        }
      ]
    },
    {
      "id": "particles",
      "shader": "particles.glsl",
      "size": [
        48,
        28
      ],
      "format": "rgba32f",
      "filter": "nearest",
      "state": true,
      "semantic": "particle-position-velocity-v1",
      "history": true,
      "inputs": [
        {
          "pass": "particles",
          "frame": "previous"
        },
        {
          "pass": "capture",
          "frame": "current"
        }
      ]
    },
    {
      "id": "finish",
      "shader": "fragments.glsl",
      "vertex": "fragments-vertex.glsl",
      "instances": 1344,
      "scale": 1,
      "format": "rgba8",
      "inputs": [
        {
          "pass": "particles",
          "frame": "current"
        },
        {
          "pass": "capture",
          "frame": "current"
        }
      ]
    }
  ],
  "motionProfile": "Persistent position and velocity; independent band forces; no shared beat reversal",
  "audioMapping": {
    "bass": "Fracture/impulse or orbital expansion",
    "mid": "Reassembly, coupling and field strength",
    "treble": "Edge-selective agitation and small-scale articulation"
  },
  "mediaRole": "captured-image-fragments",
  "behaviourModes": [
    "Shock shells",
    "Spiral conveyor",
    "Gear teeth",
    "Ring exchange"
  ],
  "stateContract": {
    "owner": "scene clip/revision/generation",
    "transfer": "compatible semantic copy or explicit incoming adapter; no raw cross-semantic blend",
    "reset": "seek/revision/generation",
    "tickHz": 60
  }
}
