{
  "schema": 1,
  "key": "original/proof-prismatic-assembly",
  "title": "Prismatic Assembly",
  "author": "Mixworks / Jay with AI assistance",
  "source": "Original analytic rigid-body collage with attached, independently moving child and grandchild image frames.",
  "family": "rigid-image-assemblage",
  "controls": {
    "intensity": {
      "min": 0,
      "max": 1,
      "default": 0.8,
      "type": "continuous",
      "label": "Lighting"
    },
    "motion": {
      "min": 0,
      "max": 1,
      "default": 0.65,
      "type": "continuous",
      "label": "Travel"
    },
    "imageMix": {
      "min": 0,
      "max": 1,
      "default": 0.95,
      "type": "continuous",
      "label": "Artwork"
    },
    "detail": {
      "min": 0,
      "max": 1,
      "default": 0.6,
      "type": "continuous",
      "label": "Frame detail"
    },
    "pulse": {
      "min": 0,
      "max": 1,
      "default": 0.85,
      "type": "continuous",
      "label": "Musical momentum"
    },
    "scale": {
      "min": 0,
      "max": 1,
      "default": 0.5,
      "type": "continuous",
      "label": "Form size"
    },
    "mode": {
      "min": 0,
      "max": 1,
      "default": 1.0,
      "type": "choice",
      "steps": 3,
      "label": "Open / mirror / kaleidoscope"
    },
    "bassDrive": {
      "min": 0,
      "max": 1,
      "default": 0.62,
      "label": "Bass response",
      "type": "continuous"
    },
    "midDrive": {
      "min": 0,
      "max": 1,
      "default": 0.6,
      "label": "Mid response",
      "type": "continuous"
    },
    "trebleDrive": {
      "min": 0,
      "max": 1,
      "default": 0.62,
      "label": "Treble response",
      "type": "continuous"
    },
    "momentum": {
      "min": 0,
      "max": 1,
      "default": 0.62,
      "label": "Release momentum",
      "type": "continuous"
    },
    "materialMotion": {
      "min": 0,
      "max": 1,
      "default": 0.35,
      "label": "Image movement",
      "type": "continuous"
    },
    "materialMode": {
      "min": 0,
      "max": 1,
      "default": 0.0,
      "label": "Image method",
      "type": "choice",
      "steps": 4
    },
    "viewPattern": {
      "min": 0,
      "max": 1,
      "default": 0.0,
      "label": "View method",
      "type": "choice",
      "steps": 5
    },
    "finishGlow": {
      "min": 0,
      "max": 1,
      "default": 0.2,
      "label": "Soft highlight glow",
      "type": "continuous"
    },
    "paletteStyle": {
      "min": 0,
      "max": 1,
      "default": 0.0,
      "type": "choice",
      "steps": 8,
      "label": "Colour palette"
    },
    "paletteAmount": {
      "min": 0,
      "max": 1,
      "default": 1.0,
      "type": "continuous",
      "label": "Palette amount"
    }
  },
  "passSchema": 2,
  "passes": [
    {
      "id": "kinematics",
      "shader": "kinematics.glsl",
      "size": [
        16,
        1
      ],
      "format": "rgba32f",
      "state": true,
      "history": true,
      "semantic": "assembly-integrated-motion-v1",
      "inputs": [
        {
          "frame": "previous",
          "pass": "kinematics"
        }
      ]
    },
    {
      "id": "surface",
      "shader": "main.glsl",
      "scale": 1,
      "format": "rgba16f",
      "inputs": [
        {
          "frame": "current",
          "pass": "kinematics"
        }
      ]
    },
    {
      "id": "bloomx",
      "shader": "bloom-x.glsl",
      "scale": 0.25,
      "format": "rgba16f",
      "inputs": [
        {
          "pass": "surface",
          "frame": "current"
        }
      ]
    },
    {
      "id": "bloomy",
      "shader": "bloom-y.glsl",
      "scale": 0.25,
      "format": "rgba16f",
      "inputs": [
        {
          "pass": "bloomx",
          "frame": "current"
        }
      ]
    },
    {
      "id": "finish",
      "shader": "finish.glsl",
      "scale": 1,
      "format": "rgba8",
      "inputs": [
        {
          "pass": "surface",
          "frame": "current"
        },
        {
          "pass": "bloomy",
          "frame": "current"
        }
      ]
    }
  ],
  "audioMapping": {
    "bass": "Strong retained parent turns, depth kick and warm edge emission",
    "mid": "Parent angular accents, child separation and colour shift",
    "treble": "Fast child/grandchild turns and cool edge glow"
  },
  "mediaRole": "Physical nested image frames: independently transformed child and grandchild move with their parent",
  "stateContract": {
    "owner": "scene clip/revision/generation",
    "reset": "seek/revision/generation",
    "tickHz": 60
  },
  "sharedShaders": {
    "bloom-x.glsl": "proof-resonant-vault/bloom-x.glsl",
    "bloom-y.glsl": "proof-resonant-vault/bloom-y.glsl",
    "finish.glsl": "proof-resonant-vault/finish.glsl"
  },
