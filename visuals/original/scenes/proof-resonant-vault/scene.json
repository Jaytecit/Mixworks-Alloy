      "type": "choice",
      "steps": 5
    },
    "finishGlow": {
      "min": 0,
      "max": 1,
      "default": 0.2,
      "label": "Soft highlight glow",
      "type": "continuous"
    }
  },
  "passSchema": 2,
  "passes": [
    {
      "id": "material",
      "shader": "material.glsl",
      "format": "rgba16f",
      "state": true,
      "semantic": "vault-transported-pigment-v1",
      "history": true,
      "inputs": [
        {
          "frame": "previous",
          "pass": "material"
        }
      ],
      "scale": 0.75
    },
    {
      "id": "impulse",
      "shader": "impulse.glsl",
      "size": [
        128,
        1
      ],
      "format": "rgba16f",
      "state": true,
      "semantic": "vault-travelling-pressure-v1",
      "history": true,
      "inputs": [
        {
          "frame": "previous",
          "pass": "impulse"
        }
      ]
    },
    {
      "id": "surface",
      "shader": "main.glsl",
      "scale": 1,
      "format": "rgba16f",
      "inputs": [
        {
          "frame": "current",
          "pass": "material"
        },
        {
          "frame": "current",
          "pass": "impulse"
        }
      ]
    },
    {
      "id": "bloomx",
      "shader": "bloom-x.glsl",
      "scale": 0.25,
      "format": "rgba16f",
      "inputs": [
        {
          "frame": "current",
          "pass": "surface"
        }
      ]
    },
    {
      "id": "bloomy",
      "shader": "bloom-y.glsl",
      "scale": 0.25,
      "format": "rgba16f",
      "inputs": [
        {
          "frame": "current",
          "pass": "bloomx"
        }
      ]
    },
    {
      "id": "finish",
      "shader": "finish.glsl",
      "scale": 1,
      "format": "rgba8",
      "inputs": [
        {
          "frame": "current",
          "pass": "surface"
        },
        {
          "frame": "current",
          "pass": "bloomy"
        }
      ]
    }
  ],
  "audioMapping": {
    "bassHit": "Travelling pressure opens local folds with release",
    "bass": "Distributed wall flex",
    "mid": "Independent pigment transport and curved axis",
    "trebleHit": "Local ridge glints and image replenishment"
