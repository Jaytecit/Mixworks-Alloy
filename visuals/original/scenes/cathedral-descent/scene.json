      "format": "rgba16f",
      "id": "light",
      "inputs": []
    },
    {
      "inputs": [
        {
          "pass": "light",
          "frame": "current"
        }
      ],
      "shader": "bloom-x.glsl",
      "scale": 0.25,
      "format": "rgba16f",
      "id": "bloomx"
    },
    {
      "inputs": [
        {
          "pass": "bloomx",
          "frame": "current"
        }
      ],
      "shader": "bloom-y.glsl",
      "scale": 0.25,
      "format": "rgba16f",
      "id": "bloomy"
    },
    {
      "inputs": [
        {
          "pass": "light",
          "frame": "current"
        },
        {
          "pass": "bloomy",
          "frame": "current"
        }
      ],
      "shader": "finish.glsl",
      "scale": 1,
      "format": "rgba8",
      "id": "finish"
    },
    {
      "id": "reflection",
      "shader": "reflection.glsl",
      "scale": 1,
      "format": "rgba8",
      "inputs": [
        {
          "pass": "finish",
          "frame": "current"
        }
      ]
    }
  ],
