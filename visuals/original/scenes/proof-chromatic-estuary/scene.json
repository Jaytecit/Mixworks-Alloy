      "min": 0,
      "max": 1,
      "default": 0.35,
      "label": "Image movement",
      "type": "continuous"
    },
    "materialMode": {
      "min": 0,
      "max": 1,
      "default": 0.0,
      "label": "Image method",
      "type": "choice",
      "steps": 4
    },
    "viewPattern": {
      "min": 0,
      "max": 1,
      "default": 0.0,
      "label": "View method",
      "type": "choice",
      "steps": 5
    },
    "finishGlow": {
      "min": 0,
      "max": 1,
      "default": 0.2,
      "label": "Soft highlight glow",
      "type": "continuous"
    }
  },
  "passSchema": 2,
  "passes": [
    {
      "id": "flow",
      "shader": "flow.glsl",
      "size": [
        384,
        216
      ],
      "format": "rgba32f",
      "filter": "linear",
      "state": true,
      "semantic": "velocity-pigment-relief-v1",
      "history": true,
      "inputs": [
        {
          "pass": "flow",
          "frame": "previous"
        }
      ]
    },
    {
      "id": "transport",
      "shader": "transport.glsl",
      "size": [
        384,
        216
      ],
      "format": "rgba32f",
      "state": true,
      "semantic": "advected-material-uv-v1",
      "history": true,
      "inputs": [
        {
          "pass": "flow",
          "frame": "current"
        },
        {
          "pass": "transport",
          "frame": "previous"
        }
      ]
    },
    {
      "id": "pigment",
      "shader": "pigment.glsl",
      "scale": 0.75,
      "format": "rgba16f",
      "state": true,
      "history": true,
      "semantic": "estuary-pigment-rgb-v1",
      "inputs": [
        {
          "pass": "flow",
          "frame": "current"
        },
        {
          "pass": "pigment",
          "frame": "previous"
        }
      ]
    },
    {
      "id": "finish",
      "shader": "main.glsl",
      "scale": 1,
      "format": "rgba8",
      "inputs": [
        {
          "pass": "flow",
          "frame": "current"
        },
        {
          "pass": "transport",
          "frame": "current"
        },
        {
          "pass": "pigment",
          "frame": "current"
        }
      ]
    }
  ],
  "motionProfile": "Persistent local flow between attacks; no beat-clock reversal",
  "audioMapping": {
    "bass": "Injects momentum into vortices",
    "mid": "Shears material with sustained circulation",
    "treble": "Fine curl forces and selective fresh pigment"
  },
  "mediaRole": "image-edge force, pigment boundary, transported nested inlay",
  "stateContract": {
    "owner": "scene clip/revision/generation",
    "transfer": "compatible semantic copy or explicit incoming adapter; no raw cross-semantic blend",
    "reset": "seek/revision/generation",
    "tickHz": 60
  },
  "sharedShaders": {
    "transport.glsl": "vein-current/transport.glsl"
  },
