  "passSchema": 2,
  "passes": [
    {
      "id": "flow",
      "shader": "flow.glsl",
      "size": [
        384,
        216
      ],
      "format": "rgba32f",
      "filter": "linear",
      "state": true,
      "semantic": "velocity-pigment-relief-v1",
      "history": true,
      "inputs": [
        {
          "pass": "flow",
          "frame": "previous"
        }
      ]
    },
    {
      "id": "transport",
      "shader": "transport.glsl",
      "size": [
        384,
        216
      ],
      "format": "rgba32f",
      "state": true,
      "semantic": "advected-material-uv-v1",
      "history": true,
      "inputs": [
        {
          "pass": "flow",
          "frame": "current"
        },
        {
          "pass": "transport",
          "frame": "previous"
        }
      ]
    },
    {
      "id": "finish",
      "shader": "main.glsl",
      "scale": 1,
      "format": "rgba8",
      "inputs": [
        {
          "pass": "flow",
          "frame": "current"
        },
        {
          "pass": "transport",
          "frame": "current"
        }
      ]
    }
  ],
  "motionProfile": "Persistent local flow between attacks; no beat-clock reversal",
  "audioMapping": {
    "bass": "Maintains vortex force; attacks inject momentum",
    "mid": "Image-edge circulation and lower drag",
    "treble": "Attacks add fine relief-driven curl"
  },
  "mediaRole": "flow-seed-refraction-colour",
  "stateContract": {
    "owner": "scene clip/revision/generation",
    "transfer": "compatible semantic copy or explicit incoming adapter; no raw cross-semantic blend",
    "reset": "seek/revision/generation",
    "tickHz": 60
  }
