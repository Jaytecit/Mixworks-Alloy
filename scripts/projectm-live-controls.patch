+void projectm_opengl_render_frame_with_controls(projectm_handle instance, projectm_feedback_input input,
+                                                  void* user_data, float decay_offset, float zoom_scale,
+                                                  float rotation_offset, float warp_offset)
+{
+    const auto bounded = [](float value, float low, float high, float neutral) {
+        return std::isfinite(value) ? std::clamp(value, low, high) : neutral;
+    };
+    const libprojectM::Renderer::FeedbackControls controls{
+        bounded(decay_offset, -.12f, .06f, 0.0f), bounded(zoom_scale, .94f, 1.06f, 1.0f),
+        bounded(rotation_offset, -.06f, .06f, 0.0f), bounded(warp_offset, -1.5f, 1.5f, 0.0f)};
+    handle_to_instance(instance)->RenderFrame(input, user_data, controls);
+}
